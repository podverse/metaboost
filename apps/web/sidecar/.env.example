NEXT_PUBLIC_DEFAULT_LOCALE="en-US"
NEXT_PUBLIC_SUPPORTED_LOCALES="all-available"
NEXT_PUBLIC_ACCOUNT_SIGNUP_MODE="admin_only_username"
NEXT_PUBLIC_WEB_BRAND_NAME="metaboost-web"
NEXT_PUBLIC_LEGAL_NAME="the site owner"
NEXT_PUBLIC_WEB_BRAND_DOMAIN="example.org"
API_PORT="4000"
NEXT_PUBLIC_API_VERSION_PATH="/v1"
NEXT_PUBLIC_API_PUBLIC_BASE_URL="http://localhost:4000"
API_SERVER_BASE_URL="http://localhost:4000"
WEB_PORT="4002"
NEXT_PUBLIC_WEB_BASE_URL="http://localhost:4002"
WEB_SIDECAR_PORT="4001"
NEXT_PUBLIC_SESSION_REFRESH_INTERVAL_MS="600000"
# Web Push (browser). Optional — leave empty to disable subscription UI / client key.
NEXT_PUBLIC_WEBPUSH_ENABLED=
NEXT_PUBLIC_WEBPUSH_VAPID_PUBLIC_KEY=
# Legacy alias for the public key (still supported):
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
